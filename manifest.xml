<?xml version="1.0" encoding="UTF-8"?>
<!--
  Calendar Search – Excel add-in manifest (XML, add-in only).

  BEFORE USE: replace every  https://YOUR-HOST.example.com/calendar-search-addin
  with your real hosting URL (no trailing slash), e.g.
     https://your-github-name.github.io/calendar-search-addin
  In Notepad: Ctrl+H > Replace All.
  Bump <Version> every time you change this file and redistribute it.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>f3ca3529-b2e1-47d5-b618-25db386e0c59</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>JBATC</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Calendar Search" />
  <Description DefaultValue="Search the 2027 Schedule calendar, summarise destination inventory and list open placements. Read-only; results stay in your own task pane." />
  <IconUrl DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/index.html" />
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.13" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/taskpane.html" />
  </DefaultSettings>
  <!-- Never edits cells. ReadWriteDocument is requested only so the pane can
       activate the sheet and move the user's selection to a clicked result. -->
  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="Support.Url" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CalSearch.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="CalSearch.OpenButton">
                  <Label resid="Button.Label" />
                  <Supertip>
                    <Title resid="Button.Label" />
                    <Description resid="Button.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CalendarSearchPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/taskpane.html" />
        <bt:Url id="Commands.Url" DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/commands.html" />
        <bt:Url id="Support.Url" DefaultValue="https://YOUR-HOST.example.com/calendar-search-addin/index.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Calendar Search is ready" />
        <bt:String id="Group.Label" DefaultValue="Calendar" />
        <bt:String id="Button.Label" DefaultValue="Calendar Search" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open it from Home > Calendar Search." />
        <bt:String id="Button.Tooltip" DefaultValue="Search the 2027 Schedule, summarise destinations and list open placements." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
